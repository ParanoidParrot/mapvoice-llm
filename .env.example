MAPVOICE_MODEL_NAME=sarvamai/sarvam-1
MAPVOICE_ADAPTER_PATH=
MAPVOICE_DEVICE=auto

# Optional active regional pack.
MAPVOICE_PACK_ID=blr-kn

# TTS
# If MAPVOICE_TTS_ENABLED is blank/unset, TTS auto-enables when
# SARVAM_API_KEY is configured. Set false to force-disable.
MAPVOICE_TTS_ENABLED=
MAPVOICE_TTS_PROVIDER=sarvam
SARVAM_API_KEY=

# Current Sarvam Bulbul defaults.
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh

# Normally supplied by the active regional pack.
SARVAM_TTS_TARGET_LANGUAGE=kn-IN
MAPVOICE_TTS_ENGLISH_LANGUAGE=en-IN
